<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KosHub.PlacesAutocomplete" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_screen</item>
        <item name="android:statusBarColor">@color/background_screen</item>
        <item name="android:navigationBarColor">@color/background_screen</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        <!-- Android 15+ compatibility: cegah Google Places Activity dipaksa edge-to-edge -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
