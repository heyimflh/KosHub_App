<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/detail_section_lokasi"
        android:textColor="@color/md_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Location Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white_border_xl"
        android:orientation="vertical">

        <!-- Google Maps MapView (Fixed Height) -->
        <com.google.android.gms.maps.MapView
            android:id="@+id/mapViewDetail"
            android:layout_width="match_parent"
            android:layout_height="180dp" />

        <!-- Route Information Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Icon -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_directions_walk"
                app:tint="@color/md_primary"
                android:contentDescription="@null" />

            <!-- Route Summary -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailRouteTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/md_on_surface"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="± 8 menit jalan kaki" />

                <TextView
                    android:id="@+id/tvDetailRouteDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="0.5 km ke Kampus" />
            </LinearLayout>

            <!-- Action Button -->
            <TextView
                android:id="@+id/btnOpenMaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_facility"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/btn_open_maps"
                android:textColor="@color/md_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
