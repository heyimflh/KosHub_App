<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutReviewPrompt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="12dp"
    android:visibility="gone"
    app:cardBackgroundColor="#F8FCF9"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="#D7E4DB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_review_icon_circle">

                <ImageView
                    android:id="@+id/ivReviewPromptIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat_review"
                    app:tint="#007A4D" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewPromptTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Bagikan pengalamanmu"
                    android:textColor="#17231D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tvReviewPromptSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bantu mahasiswa lain memilih kos yang tepat."
                    android:textColor="#6F7F75"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWriteReviewPrompt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Tulis Ulasan"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#007A4D"
            app:cornerRadius="15dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>