<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etKosName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Kos"
            android:inputType="text" />

        <EditText
            android:id="@+id/etKosAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Alamat"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvAddressHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pilih alamat dari Google Maps agar lokasi kos valid dan bisa dihitung jaraknya ke kampus."
            android:textColor="@color/mgmt_text_muted"
            android:textSize="11sp"
            android:paddingStart="4dp" />

        <EditText
            android:id="@+id/etKosPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Harga Mulai (Angka Saja)"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kategori" />

        <Spinner
            android:id="@+id/spKosCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:entries="@array/kos_categories" />

        <!-- Additional Structured Data Buttons -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mgmt_structured_data_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditRoomFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mgmt_btn_room_features"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnEditAccessFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mgmt_btn_access_features"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnEditSecurityFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mgmt_btn_security_features"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnEditRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mgmt_btn_rules"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Foto Kos"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvImageHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tambahkan hingga 5 foto. Foto pertama akan menjadi cover utama."
            android:textColor="@color/mgmt_text_muted"
            android:textSize="11sp"
            android:paddingStart="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImagePreviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp" />

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Tambah Foto Kos"
            android:textAllCaps="false"
            android:textColor="@color/brand_green"
            style="@style/Widget.AppCompat.Button.Borderless.Colored" />

    </LinearLayout>
</ScrollView>
